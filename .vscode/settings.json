{
    "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      "**/run/": true,
    },
    "workbench.colorCustomizations": {
      "[*]": {
        "activityBar.background": "#1a092e",
        "titleBar.activeBackground": "#290a4d",
        "sideBar.background": "#222222",
        "editor.background": "#180913",
      },
      
    },
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "clangd.detectExtensionConflicts": false,
    // "cmake.ctest.parallelJobs": 4,
    "cmake.exportCompileCommandsFile": false, // Use vscode -> Run Task -> Update compile_commands.json
    "cmake.generator": "Ninja Multi-Config",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureArgs": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=OFF", // Use vscode -> Run Task -> Update compile_commands.json
        "-DCMAKE_INSTALL_PREFIX=${workspaceFolder}/dist",
        "-DPROJECT_DEPS_PATH:PATH=/data/dev/daw-deps",
        // "-DPROJECT_DEPS_PATH:PATH=C:/dev/daw-deps",
        "-DPROJECT_DEPS_INSTALL_PATH:PATH=/data/dev/build-deps/install",
        // "-DPROJECT_DEPS_INSTALL_PATH:PATH=C:/dev/daw-deps-install/llvm-mingw-20250709-ucrt-x86_64",
        // "-DPROJECT_VST2_OUTPUT_PATH:PATH=/data/vst2-dev",
        "-DPROJECT_BUILD_PLUGINS=OFF",
        "-DPROJECT_BUILD_TESTS_UI=ON",
        "-DPROJECT_PRODUCT_NAME:STRING='Bass Studio'",
        "-DPROJECT_BINARY_NAME:STRING='bass'",
        "-DPRODUCT_HOST_NAME:STRING='bass'",
        "-DPROJECT_VENDOR_NAME:STRING='Michael Hept'",
        "-DPRODUCT_URL_DOCS:STRING='https://bass-studio.com'",
        "-DPRODUCT_URL_VENDOR:STRING='https://bass-studio.com'",
        "-DPROJECT_WORKING_DIR:PATH=~/run",
        // "-DPROJECT_WORKING_DIR:PATH=../../run",
        // "-DCMAKE_OPTIMIZE_DEPENDENCIES=ON",
        "-DCMAKE_DISABLE_PRECOMPILE_HEADERS=OFF",
        "-DCMAKE_VERBOSE_MAKEFILE=OFF",
        "-DCMAKE_UNITY_BUILD=OFF",
        "-DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF",
        "-DPROJECT_CFG_OPTIMIZE=native",
        "-DPROJECT_ENABLE_PYTHON=ON",
        "-DPython_ROOT_DIR=/usr/bin/python3",
        // "-DPROJECT_CFG_NO_OMIT_FRAME_POINTER=ON",
        // "-DPROJECT_CFG_FSANITIZE=memory",
        // "-DPROJECT_GENERATE_LINKER_MAP=OFF",
   ],
    "clangd.arguments": ["--log=error"],
    "cmake.options.statusBarVisibility": "visible",
}