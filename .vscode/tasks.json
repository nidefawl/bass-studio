{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "test_math-Clang-debug",
            "command": "cmake",
            "args": [
                "--build",
                ".",
                "--target",
                "test_math",
                "|",
                "tee",
                "build.log"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build/clang-ninja-daw-build"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },

            "runOptions": {
                "reevaluateOnRerun": true
            }
        },
        {
            "type": "shell",
            "label": "clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "/usr/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "/usr/bin"
            }
        },
        {
            "type": "shell",
            "label": "clang build active file",
            "command": "/usr/local/opt/llvm/bin/clang",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "/usr/local/opt/llvm/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "MacOS make ~/dev/build",
            "command": "make",
            "args": [
                "-j",
                "6"
            ],
            "options": {
                "cwd": "/Users/mac-user/dev/build2"
            },
            "problemMatcher": []
        },
        {
            "label": "Linux make ~/dev/build",
            "command": "make",
            "args": [
                "-j",
                "6"
            ],
            "options": {
                "cwd": "/home/michael/dev/build"
            },
            "group": "build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "absolute"
                ]
            }
        },
        {
            "label": "Linux make ~/dev/build2",
            "command": "make",
            "args": [
                "-j",
                "6"
            ],
            "options": {
                "cwd": "/home/michael/dev/build2"
            },
            "group": "build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "absolute"
                ]
            }
        }
    ]
}