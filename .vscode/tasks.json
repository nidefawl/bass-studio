{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "C:/Program Files/Git/bin/bash.exe",
                "args": ["-c"]
            }
        }
    },
    "tasks": [
        {
            "label": "Build (CMake target)",
            "type": "process",
            "windows": {
                "args": [
                    "/C",
                    "${command:cmake.tasksBuildCommand}"
                ],
                "command": "cmd.exe",
            }, 
            "linux": {
                "args": ["-c", "${command:cmake.tasksBuildCommand}"],
                "command": "zsh",
            },
            "command": "",
            "problemMatcher": []
        },
        {
            "label": "Update compile_commands.json",
            "type": "shell",
            "command": "./local-update-cc.sh",
            "problemMatcher": []
        },
        {
            "label": "Delete .cache/clangd",
            "type": "shell",
            "args": ["-Rf", ".cache/clangd"],
            "command": "rm",
            "problemMatcher": []
        }
    ]
}