#include "winver.h"

#cmakedefine VER_FILEVERSION @VER_FILEVERSION@
#cmakedefine VER_FILEVERSION_STR "@VER_FILEVERSION_STR@"
#cmakedefine VER_PRODUCTVERSION @VER_PRODUCTVERSION@
#cmakedefine VER_PRODUCTVERSION_STR "@VER_PRODUCTVERSION_STR@"
#cmakedefine VER_PRODUCTNAME_STR "@VER_PRODUCTNAME_STR@"
#cmakedefine VER_FILENAME_STR "@VER_FILENAME_STR@"
#cmakedefine VER_COPYRIGHT_STR "@VER_COPYRIGHT_STR@"
#cmakedefine VER_FILDESCRIPTION_STR "@VER_FILDESCRIPTION_STR@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   0x17L
#ifndef NDEBUG
FILEFLAGS       (VS_FF_PRERELEASE|VS_FF_DEBUG)
#else
FILEFLAGS       (VS_FF_PRERELEASE)
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "FileDescription",  VER_FILDESCRIPTION_STR
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     VER_PRODUCTNAME_STR
            VALUE "LegalCopyright",   VER_COPYRIGHT_STR
            VALUE "OriginalFilename", VER_FILENAME_STR
            VALUE "ProductName",      VER_PRODUCTNAME_STR
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 850

    END
END
